<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>정유원 | Big Data Portfolio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;700;900&display=swap');

        :root {
            --primary: #3b82f6; /* Electric Blue */
            --secondary: #8b5cf6; /* Violet */
            --bg-dark: #050505;
            --card-bg: rgba(255, 255, 255, 0.03);
        }

        body {
            background-color: var(--bg-dark);
            color: white;
            font-family: 'Pretendard', sans-serif;
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        /* 배경 애니메이션 */
        .bg-glow {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60vw;
            height: 60vw;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.05) 50%, transparent 100%);
            z-index: -1;
            filter: blur(80px);
            animation: pulse 10s infinite alternate;
        }

        @keyframes pulse {
            0% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
            100% { transform: translate(-45%, -55%) scale(1.2); opacity: 0.8; }
        }

        .glass-nav {
            background: rgba(5, 5, 5, 0.7);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* 텍스트 그라데이션 */
        .gradient-text {
            background: linear-gradient(135deg, #fff 30%, var(--primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .project-card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.5s cubic-bezier(0.2, 1, 0.3, 1);
            backdrop-filter: blur(10px);
        }

        .project-card:hover {
            transform: translateY(-15px) scale(1.02);
            border-color: var(--primary);
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.7), 0 0 20px rgba(59, 130, 246, 0.2);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            transition: all 0.3s;
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.5);
        }

        .tag {
            background: rgba(59, 130, 246, 0.1);
            color: var(--primary);
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
    </style>
</head>
<body class="antialiased">
    <div class="bg-glow"></div>

    <!-- Navigation -->
    <nav class="glass-nav fixed w-full z-50 px-8 py-5 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center font-black text-xs">Y</div>
            <div class="text-lg font-black tracking-tighter">정유원<span class="text-blue-500">.DATALAB</span></div>
        </div>
        <div class="space-x-10 text-[11px] font-bold tracking-[0.2em] hidden md:flex">
            <a href="#home" class="hover:text-blue-400 transition">HOME</a>
            <a href="#projects" class="hover:text-blue-400 transition">PROJECTS</a>
            <a href="#about" class="hover:text-blue-400 transition">ABOUT</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <header id="home" class="min-h-screen flex flex-col justify-center items-center px-6 text-center">
        <div class="space-y-4 mb-8">
            <span class="inline-block px-4 py-1 rounded-full border border-blue-500/30 bg-blue-500/5 text-blue-400 text-[10px] font-bold tracking-widest uppercase animate-pulse">
                Haneol High School • Jung Yu-won
            </span>
            <h1 class="text-6xl md:text-[7rem] font-black leading-[0.9] tracking-tighter gradient-text">
                DATA IS<br>MY STORY
            </h1>
            <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed pt-4">
                한얼고등학교 <strong>정유원</strong>입니다. 빅데이터 분석을 통해<br class="hidden md:block"> 
                세상의 복잡한 패턴을 발견하고 가치 있는 통찰력을 만듭니다.
            </p>
        </div>
        <div class="flex gap-4">
            <a href="#projects" class="btn-primary px-8 py-4 rounded-xl font-bold text-sm">
                프로젝트 보기
            </a>
            <a href="#about" class="px-8 py-4 rounded-xl border border-white/10 font-bold text-sm hover:bg-white/5 transition">
                소개
            </a>
        </div>
    </header>

    <!-- Projects Section -->
    <section id="projects" class="py-32 px-6 max-w-7xl mx-auto">
        <div class="flex flex-col mb-16">
            <h3 class="text-blue-500 font-bold tracking-[0.3em] text-sm uppercase mb-2">Portfolio Archive</h3>
            <h2 class="text-4xl md:text-6xl font-black tracking-tighter">분석의 기록들</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- 01 -->
            <a href="01.html" class="project-card rounded-3xl p-8 flex flex-col h-[400px] group">
                <div class="mb-auto">
                    <div class="flex justify-between items-center mb-6">
                        <i class="fa-solid fa-scooter text-3xl opacity-50 group-hover:text-blue-400 transition"></i>
                        <span class="text-[10px] font-bold opacity-30">01</span>
                    </div>
                    <h4 class="text-2xl font-bold mb-4">킥보드 교통사고 분석</h4>
                    <p class="text-gray-500 text-sm">PM 이동수단 증가에 따른 지리적 위험 구역 탐색 및 사고 유형 데이터 시각화</p>
                </div>
                <div class="flex flex-wrap gap-2 mt-6">
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">지리 데이터</span>
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">안전</span>
                </div>
            </a>

            <!-- 02 -->
            <a href="02.html" class="project-card rounded-3xl p-8 flex flex-col h-[400px] group">
                <div class="mb-auto">
                    <div class="flex justify-between items-center mb-6">
                        <i class="fa-solid fa-earth-americas text-3xl opacity-50 group-hover:text-blue-400 transition"></i>
                        <span class="text-[10px] font-bold opacity-30">02</span>
                    </div>
                    <h4 class="text-2xl font-bold mb-4">지구 온난화 추이 분석</h4>
                    <p class="text-gray-500 text-sm">글로벌 기온 데이터 세트를 활용한 100년간의 온도 변화 및 환경 임계점 예측</p>
                </div>
                <div class="flex flex-wrap gap-2 mt-6">
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">시계열 분석</span>
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">환경</span>
                </div>
            </a>

            <!-- 03 -->
            <a href="03.html" class="project-card rounded-3xl p-8 flex flex-col h-[400px] group">
                <div class="mb-auto">
                    <div class="flex justify-between items-center mb-6">
                        <i class="fa-solid fa-coins text-3xl opacity-50 group-hover:text-blue-400 transition"></i>
                        <span class="text-[10px] font-bold opacity-30">03</span>
                    </div>
                    <h4 class="text-2xl font-bold mb-4">대학 1인당 교육비 분석</h4>
                    <p class="text-gray-500 text-sm">전국 대학 재정 공시 데이터를 바탕으로 한 학생 1인당 교육 투자비 효율성 비교</p>
                </div>
                <div class="flex flex-wrap gap-2 mt-6">
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">재정 데이터</span>
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">교육</span>
                </div>
            </a>

            <!-- 04 (Main) -->
            <a href="04.html" class="project-card rounded-3xl p-8 flex flex-col h-[400px] group md:col-span-2 bg-gradient-to-br from-blue-900/10 to-transparent border-blue-500/20">
                <div class="mb-auto">
                    <div class="flex justify-between items-center mb-6">
                        <i class="fa-solid fa-star text-3xl text-blue-500"></i>
                        <span class="text-[10px] font-bold text-blue-500">MAIN PROJECT</span>
                    </div>
                    <h4 class="text-3xl font-bold mb-4">나의 진학 데이터 분석</h4>
                    <p class="text-gray-400 text-base max-w-xl">개인 성적 추이와 목표 대학 합격선 데이터를 결합하여 도출한 정량적 진학 로드맵 설계</p>
                </div>
                <div class="flex items-center justify-between mt-6">
                    <div class="flex gap-2">
                        <span class="tag px-4 py-1 rounded-full text-[11px] font-bold">Personalized</span>
                        <span class="tag px-4 py-1 rounded-full text-[11px] font-bold">Predictive Model</span>
                    </div>
                    <div class="w-10 h-10 rounded-full border border-blue-500/50 flex items-center justify-center group-hover:bg-blue-500 transition-all">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- 05 -->
            <a href="05.html" class="project-card rounded-3xl p-8 flex flex-col h-[400px] group">
                <div class="mb-auto">
                    <div class="flex justify-between items-center mb-6">
                        <i class="fa-solid fa-robot text-3xl opacity-50 group-hover:text-purple-400 transition"></i>
                        <span class="text-[10px] font-bold opacity-30">05</span>
                    </div>
                    <h4 class="text-2xl font-bold mb-4">AI 윤리 & 사이버 폭력</h4>
                    <p class="text-gray-500 text-sm">유튜브 댓글 및 영상 데이터를 활용한 사이버 폭력 양상 및 AI 윤리 인식 마이닝(조별)</p>
                </div>
                <div class="flex flex-wrap gap-2 mt-6">
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">텍스트 마이닝</span>
                    <span class="tag px-3 py-1 rounded-full text-[10px] font-bold">Team Project</span>
                </div>
            </a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-32 bg-white text-black">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-5xl font-black tracking-tighter mb-8 leading-none">한얼고등학교<br>분석가 <span class="text-blue-600">정유원</span></h2>
                    <p class="text-gray-600 text-lg leading-relaxed mb-8">
                        단순한 데이터 수집을 넘어 사회적 현상과 개인의 성장을 숫자로 증명하는 과정을 즐깁니다. 
                        빅데이터 분석 수업을 통해 데이터의 힘을 경험하였으며, 이를 통해 더 나은 의사결정을 돕는 인사이트를 제공하고자 합니다.
                    </p>
                    <div class="grid grid-cols-2 gap-8">
                        <div>
                            <h4 class="font-bold text-sm mb-2 uppercase tracking-widest text-blue-600">Skillset</h4>
                            <p class="text-sm">Python, R, SQL, Tableau</p>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm mb-2 uppercase tracking-widest text-blue-600">Interests</h4>
                            <p class="text-sm">AI Ethics, NLP, EDA</p>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <div class="aspect-square bg-gray-100 rounded-3xl overflow-hidden flex items-center justify-center p-12">
                        <i class="fa-solid fa-database text-[12rem] text-gray-200"></i>
                    </div>
                    <div class="absolute -bottom-6 -right-6 bg-blue-600 text-white p-8 rounded-2xl shadow-2xl">
                        <p class="text-2xl font-black">2024</p>
                        <p class="text-xs font-bold opacity-70">Portfolio Year</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-20 px-6 border-t border-white/10 text-center">
        <p class="text-gray-500 text-xs font-bold tracking-[0.4em] mb-4 uppercase">© 2024 Haneol High School Jung Yu-won</p>
        <div class="flex justify-center gap-6 text-xl">
            <i class="fa-brands fa-github opacity-30 hover:opacity-100 cursor-pointer transition"></i>
            <i class="fa-solid fa-envelope opacity-30 hover:opacity-100 cursor-pointer transition"></i>
        </div>
    </footer>

    <script>
        // 스크롤 감지 네비게이션 효과
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.style.padding = '1rem 2rem';
            } else {
                nav.style.padding = '1.25rem 2rem';
            }
        });
    </script>
</body>
</html>
